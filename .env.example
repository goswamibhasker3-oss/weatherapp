# Copy to .env and fill in. Never commit .env.
OPENWEATHER_API_KEY=your_api_key_here

# PostgreSQL (optional: leave empty to run without a database).
# This default matches docker-compose.yml. On hosting platforms use the URL they give you.
DATABASE_URL=postgresql://weather:weather@localhost:5432/weatherdb
DB_POOL_MAX=5

# Optional
PORT=5000
FLASK_DEBUG=0
CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=60